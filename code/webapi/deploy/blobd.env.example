# blobd 的环境变量（复制到 /etc/blobd/blobd.env 后按需修改）
#
# 下面的键来自代码里的 `DP_ENVS` 声明（code/sup/dp_env.h）：名字与类型由它定，
# 缺必填键（APP_ROOT）服务直接拒起；不写可选键则用声明里的默认值。
# 用户 TU 里读这些变量会被符号审计拒绝 —— 只有 dp_cfg.c 能读环境。

# 只监听回环，让 nginx / caddy 反代对外。要直接对外就改成 0.0.0.0
APP_BIND=127.0.0.1
APP_PORT=8787

# 数据目录（必填）：首次启动前手动 mkdir 并 chown blobd:blobd
APP_ROOT=/var/lib/blobd/data

# 鉴权令牌：生产必填，否则 /v1/* 对所有人开放（声明里的空默认值就是显式不鉴权）
# 生成：
#   head -c 32 /dev/urandom | base64
APP_TOKEN=change-me

# 单次 PUT 的 body 上限（字节）
APP_MAX_BODY=8388608

# 以下两项是**运维钩子**，不在 env 声明里：它们的值是 shell 命令与窗口秒数，
# 服务本身不解析它们，因此仍走 DP_ 前缀。
#
# 版本化：留空则只写快照、不做 git 提交。
# 子进程的 cwd 是 APP_ROOT，环境里带 DP_COMMIT_KEY（本次写入的 key）。
#
# 重要：这个命令会被**并发**拉起（每次成功写入一个子进程，防抖为 0 时不合并）。
# 直接跑 git commit 会抢 HEAD 的 ref 锁并静默丢掉一条提交，所以用 flock 串行。
# 只 add 这一个路径：扫全树会撞上正在 rename 的临时文件。
# 建议把它写成一个小脚本（/etc/blobd/commit.sh）：
#   #!/bin/sh
#   git add -A -- "$DP_COMMIT_KEY" &&
#   git -c user.name=blobd -c user.email=blobd@localhost commit -q -m "data: $DP_COMMIT_KEY"
DP_COMMIT_CMD='flock /var/lib/blobd/commit.lock sh /etc/blobd/commit.sh'

# 提交防抖窗口（秒），默认 60；0 表示每次写都提交
# 注意：0 不等于"每写必得一条提交" —— 写入快于 git 时，两次提交会看到同一份文件，
# 先拿到锁的那次为空，快照被合并。要逐写留档就在写端放慢，或接受合并。
DP_COMMIT_DEBOUNCE=60
