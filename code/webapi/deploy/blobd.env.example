# blobd 的环境变量（复制到 /etc/blobd/blobd.env 后按需修改）
#
# 这里的值原样传给进程：systemd 不做变量展开，$DP_COMMIT_KEY 由后面的 sh -c 展开。
#
# 下面五个键来自代码里的 `env App` 声明（code/webapi/src/contract.dlt）：
# 名字与类型由它定，缺必填键（APP_ROOT）服务直接拒起；不写可选键则用声明里的默认值。
# 改了声明就改这里 —— 对照表可用 `droplet contract …|jq .envs` 导出。

# 只监听回环，让 nginx / caddy 反代对外。要直接对外就改成 0.0.0.0
APP_BIND=127.0.0.1
APP_PORT=8787

# 数据目录（必填）：首次启动前手动 mkdir 并 chown blobd:blobd
APP_ROOT=/var/lib/blobd/data

# 鉴权令牌：生产必填，否则 /v1/* 对所有人开放（声明里的空默认值就是显式不鉴权）
# 生成：
#   head -c 32 /dev/urandom | base64
APP_TOKEN=change-me

# 单次 PUT 的 body 上限（字节）
APP_MAX_BODY=8388608

# 以下两项是**运维钩子**，不在 env 声明里：它们的值是 shell 命令与窗口秒数，
# 语言侧不消费，因此仍走 DP_ 前缀（登记于 docs/D0-DEVIATIONS.md）。
# 版本化：留空则只写快照、不做 git 提交。
# 子进程的 cwd 是 APP_ROOT，环境里带 DP_COMMIT_KEY（本次写入的 key）。
# 只 add 这一个路径：扫全树会撞上正在 rename 的临时文件。
DP_COMMIT_CMD='git add -A -- "$DP_COMMIT_KEY" && git -c user.name=blobd -c user.email=blobd@localhost commit -q -m "data: $DP_COMMIT_KEY"'

# 提交防抖窗口（秒），默认 60；0 表示每次写都提交
DP_COMMIT_DEBOUNCE=60
