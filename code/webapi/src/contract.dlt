// 通用哑存储 Web API 契约：服务端只做字节读写，不解构 payload。
type ETag {
  hash: u64
}

// 错误变体的声明顺序就是 tag 顺序（checker 从 100 起编号），运行时按 tag 映射状态码：
// NotFound→404、BadRequest→400、Conflict→409、NotAllowed→405、PreconditionFailed→412。
// 改顺序就得同步改 rt.h 的 DP_ERR_*（由 gen 的 TestErrTagsMatchRuntime 把守）。
type ApiError = NotFound | BadRequest | IoError | Conflict | NotAllowed | PreconditionFailed

// 服务底座配置：键名与类型固定（运行时按这五个键服务），默认值就写在声明里。
// 源码里不出现环境变量名：读取面由块名推出，root → APP_ROOT。
// token 的空默认值是**显式书写**的：不鉴权这件事写在代码里，部署时只能补上、不能抹掉。
env App {
  port: u64 = 8787,
  bind: str = "0.0.0.0",
  root: str,
  token: str = "",
  max_body: u64 = 8388608
}

host BlobFs {
  fn read(str, str) -> bytes | ApiError
  fn write(str, str, bytes) -> ETag | ApiError
  fn backup(str, str) -> Unit
  fn create(str, str) -> bool | ApiError
  fn list_json(str) -> bytes | ApiError
}

host Versioning {
  fn commit_soon(str, str) -> Unit
}

// 服务形态的入口就是这张表（D3）：`@get("/v1/blob")` 是对外路由（动词与路径都写出来，
// 不从方法名推），`impl blob_get` 指明实现函数。契约与实现因此对不上就会编译失败。
//
// 写路由必须显式表态预条件：`with precondition`（进 handler 之前比对 If-Match），
// 或 `without precondition: "理由"` —— 沉默等于默认不做并发保护，这与「错误不可丢弃」
// 是同一条纪律：不放行"忘了写"。
//
// 成功码同样是投影：默认 200，`@created` → 201，`@no_content` → 204（数字永远不进源码，
// 与错误变体 → 状态码共用同一条纪律）。204 没有表示，所以它只能投在没有 body 的成功类型上。
boundary BlobApi @v1 {
  health() -> bytes
    @get("/health") impl health
    invariant "探活不鉴权，恒回一行 ok"

  get(key: str) -> bytes
    @get("/v1/blob") impl blob_get with idempotency
    invariant "同一 key 的 GET 字节等于最近一次成功 PUT 的字节"

  put(key: str, body: bytes) -> Unit
    @put("/v1/blob") @no_content impl blob_put with idempotency, precondition
    invariant "PUT 前必须存在上一版本快照"

  list() -> bytes
    @get("/v1/keys") impl keys_list with idempotency
    invariant "清单来自目录，不来自任何注册表文件"

  create(key: str) -> Unit
    @post("/v1/keys") @created impl keys_create with idempotency
    without precondition: "创建新 key 没有既有版本可比；同 key 重复创建由 create 自己报 409"
    invariant "POST 只在 key 不存在时成功"
}
