// 示例服务的实现：路由在 contract.dlt 的 boundary 里声明，这里只写每条的实现。
// 成功即值：有体返回 bytes，无体就是裸 `return`；状态码由错误变体经标签表映射，
// 实现里不出现任何数字（SPEC §2.2 H7 / D2 的 R1–R3）。

fn health() -> bytes | ApiError {
  return b"{\"ok\":true}"
}

fn blob_get(key: str, fs: BlobFs, cfg: App) -> bytes | ApiError {
  return fs.read(cfg.root, key)!
}

fn blob_put(key: str, body: bytes, fs: BlobFs, ver: Versioning, cfg: App) -> Unit | ApiError {
  // If-Match 的比对不在这里：路由声明了 `with precondition`，守卫由生成的 dispatcher
  // 在调用本函数之前跑（D3）。这里只看得到已经通过版本检查的请求。
  fs.backup(cfg.root, key)
  // write 返回的新版本 ETag 这里用不上：响应头里的 ETag 由运行时从 body 推导，
  // 客户端要新版本号就 GET（v0.10，SPEC §2.2 H7）。
  fs.write(cfg.root, key, body)!
  ver.commit_soon(cfg.root, key)
  return
}

fn keys_list(fs: BlobFs, cfg: App) -> bytes | ApiError {
  return fs.list_json(cfg.root)!
}

fn keys_create(key: str, fs: BlobFs, cfg: App) -> Unit | ApiError {
  fs.create(cfg.root, key)!
  return
}
