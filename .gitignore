# 编译产物
a.out

# 本地构建临时目录（沙盒里 /tmp 不可写，TMPDIR 指向这里）
/.build/

# 测试与覆盖率
*.test
*.out

# 例外：drop/ 的 *.out 是「期望输出」，属于题面，必须进仓库
# （门拿它逐字比对；被上面那条吞掉过一次，干净克隆里那段等于没跑，见 drop/check.sh Z7）
!drop/examples/*.out
!drop/tests/*.out

# Python 检查器的字节码（ab-score.py 用 importlib 载入 dpt-check.py 时生成）
__pycache__/

# 第二宿主的构建产物（源码进仓库，产物不进）
drop/hosts/csharp/bin/
drop/hosts/csharp/obj/
drop/hosts/csharp/build.log

# 干净房间那三份自证脚本每次跑都会留下捕获文件（stdout/stderr/服务端输出）。
# 它们是运行痕迹不是题面 —— 题面只有那些 .dr；期望值由 conform.sh 现算，不留档，免得变成第二套台账。
drop/hosts/csharp/probe/.*
drop/hosts/csharp/probe/shapes/.*
