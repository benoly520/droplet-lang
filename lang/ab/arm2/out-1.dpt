service ab {
  src S1 "清单接口 GET /v1/items 返回一个 JSON 对象，顶层键是 items，值是字符串数组。"
  src S2 "目录为空时也要返回合法对象，items 是空数组，不要返回空 body。"
  src S3 "清单必须是按字典序排列的。"

  promise R1 "GET /v1/items 正常响应时，body 逐字节精确等于顶层只有 items 一个键、值为字符串数组的 JSON 对象" {
    from S1
    status regress
    goal list_envelope
    wire 5
    reads "照 #5 的口径跑：GET /v1/items 的响应 body 逐字节精确等于 {\"items\":[\"a\",\"b\"]}；由这一次精确比对同时认定顶层键名 items、外层是对象、值仍是数组"
    bounds "不约束状态码与鉴权（清单里能碰这两者的判据只有 #1/#2，归 R4）；不约束数组元素的排列（归 R3）；不约束空目录（归 R2）；不约束元素取值、条数上限与字符编码；不主张 JSON 空白风格（散文没写，不塞进排除里）"
    trap "退回裸数组（S1 弄红 #5）；键名换成 data 之类被精确比对拦住；但 #5 只有一组固定输入，写死 {\"items\":[\"a\",\"b\"]} 的桩实现、或两个以上元素时不排序，都能骗过本条 —— 桩风险见 G1，元素级判据缺失见 G6，排序由 R3 兜"
    evidence S1
  }

  promise R2 "目录为空时 body 逐字节精确等于 {\"items\":[]}，空 body 不算合法对象" {
    from S1,S2
    status regress
    goal empty_is_object
    wire 6
    reads "照 #6 的口径跑：空目录下 GET /v1/items 的 body 逐字节精确等于 {\"items\":[]}；据此空 body、裸空数组、items 为 null 都算违反"
    bounds "不约束空目录下的状态码（清单里没有判它的断言 -> G2）；不约束非空目录（归 R1）；不约束空数组的排序（空数组无顺序，@2 只判 dec_sort 函数层）；不约束错误响应"
    trap "S2 让空目录返回空 body，弄红 #6；但对任何目录都回 {\"items\":[]} 的桩实现骗得过本条，只能靠 R1 的 #5 一起拦住；把 204/404 的空响应与空 body 混为一谈也没判据 —— 见 G2"
    evidence S2
  }

  promise R3 "items 值数组按码位字典序升序排列，由 dec_sort 提供" {
    from S3,S1
    status regress
    unit 1,2
    reads "跑样例 @1 dec_sort([\"b\",\"a\"]) == [\"a\",\"b\"] 与 @2 dec_sort([]) == []：这是函数级判据，不经过 HTTP，也不看响应体"
    bounds "不约束排序发生在服务端还是客户端；没有任何断言把 #5 的 body 与 dec_sort 连起来，所以不证明接口真的调用了它；不约束大小写、非 ASCII、重复值、三个以上元素的顺序（-> G3）；不约束状态码与错误响应"
    trap "只写死 [\"a\",\"b\"] 的桩实现能骗过 @1（它就这一组输入）；TASK 明说清单里没有「排完再倒序」这类变异，所以手上没有任何实现变异能证明真排过；三元素以上乱序、大小写混合也无判据 -> G3"
    evidence @1,@2
  }

  promise R4 "孤儿判据登记：#1/#2/#3/#4 都不由这三句需求承诺，本条不承诺任何行为，只把变异 S3、S4 与这四条断言认领到有名有姓的地方" {
    from S1
    status gap
    wire 1,2,3,4
    reads "本条不新增判据，只复述清单已有断言：#1 GET /v1/health 200、#2 GET /v1/items 未鉴权 401、#3 GET 单项 200、#4 未知 key 404；变异表把 S3 记为弄红 #1、S4 记为弄红 #2，落点都在前两条上"
    bounds "不承诺鉴权语义、不承诺任何状态码、不承诺 health 响应体、不承诺单项与未知 key 的行为；不证明 S1/S2/S3 中任何一句；wire 同时声明 1 与 2 是故意的，因为散文与 JSON 对 S3 的弄红目标口径不一致（-> G5），两条都在才算得出 L4；wire 再带上 3 与 4 是因为检查器把没人引用的断言也记 E18 孤儿（-> G7）；本条不声明 goal，因为任何 goal 的 proven 集都与 {1,2,3,4} 不等（L3）"
    trap "本条没有行为承诺，任何实现都骗不过它；真正的骗法是把 #1/#2/#3/#4 变红当成需求已被满足，或把本条当鉴权需求去验收 —— 前者归 G4，后者归 G5；把 #3/#4 写进 wire 也不是承诺，理由见 G7；孤儿判据若没人认领是 E18 红，不会让本条变绿"
    evidence S3,S4
  }

  choice A1 S1 "顶层恰好只有 items 一个键，多出任何键即违反" "顶层至少含 items 键，允许并存其它键" "恰好只有 items 一个键" "#5 是对 body 的逐字节精确等值，多一个键立刻变红；散文没提第二个键，取强读法"
  choice A2 S1 "值数组的元素可以是任何 JSON 字符串，含空串与重复值" "元素必须非空且互不相同" "允许任何字符串，含空串与重复" "S1 原话只说「字符串数组」，#5 也没有非空/唯一判据；把缺口记进 G1 而不是偷偷扩约束"
  choice A3 S2 "只禁止 body 长度为 0，状态码不在本三句之内" "必须 200 且 body 为 {\"items\":[]}，任何非 200 都算空 body 的变体" "只禁止 body 长度为 0" "#6 只精确比对 body，清单里没有判空目录状态码的断言；取弱读法，缺口交给 G2 由人拍板"
  choice A4 S3 "字典序 = Unicode 码位序，大小写敏感" "字典序 = 忽略大小写或本地化 collation" "码位序，大小写敏感" "@1/@2 的输入只有 a、b 与空数组，两种读法都能过，现有判据分不开；按 dec_sort 的标准字符串比较取码位序，分歧记 G3"

  hole G1 R1 "缺元素级判据：#5 只有一组固定输入 a,b，没有空串、重复值、非 ASCII、三个以上元素的断言，也没有识别桩实现的判据；三句原文没提这些，故不算违约；闭合编号：需清单补一条多样本断言，现清单里没有" waived
  hole G2 R2 "缺空目录的状态码判据：#6 只比 body，S2 也只弄红 body，而 S2 原话「不要返回空 body」并没规定状态码；不违约；闭合编号：待补断言「空目录 GET /v1/items 为 200 且 body 等于 {\"items\":[]}」" waived
  hole G3 R3 "缺排序的反证判据：清单明确没有「排完再倒序」变异，样例只有 a/b 一组，大小写、非 ASCII、重复值、三元素以上均无判据；不违约，但本条目前只证 dec_sort 会排两个元素；闭合编号：需补样例 @3 与一条把接口 body 与 dec_sort 连起来的断言" waived
  hole G4 R4 "需求侧缺「鉴权/存活」这一句原文，而孤儿变异 S3、S4 只有 #1/#2 打得中；不能凭空造承诺，故用 status gap 的本条认领它们；不算违约；闭合编号：待需求方补 src 后再定它归哪条 promise" waived
  hole G5 R4 "清单两份口径冲突：TASK.md 散文说 S3「去掉鉴权」弄红 #2，inventory.json 记 S3 弄红 #1；droplet.dpt 规定引用按清单解析，故以 JSON 为准，同时声明 wire 1,2 让两种口径下 L4 都成立；不算违约；闭合编号：等 mutants.S3 改正后删去多余 wire" waived
  hole G6 R1 "缺基线状态判据：清单只给断言号与变异表，没给现实现下 #5 的通过情况，status 因此按 regress 登记（变异表是对现实现的变异，暗示现状存在）；若实盘基线判红，本条应改 new，并按 L8/E19 补基线证据；不算违约；闭合编号：待验收表加一条基线状态记录" waived
  hole G7 R4 "缺『孤儿断言该由谁承诺』的判据：定义 L7/E18 只说变异与样例没人认领算孤儿，检查器实盘把每条断言都要求被某条 promise 的 wire 引用，于是与本三句无关的 #3/#4 只能挂进 status gap 的本条；不算违约，本条也不因 wire 变宽而多证明任何一句；闭合编号：等定义与 dpt-check 对账后再删去多余 wire" waived
}
