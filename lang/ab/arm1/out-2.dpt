// 登记件：三句文本需求 S1/S2/S3 -> 承诺 R1..R4，歧义 A1..A4，缺口 G1..G4
// 引用口径：wire / unit / goal / evidence 的 S 变异一律按 inventory.json 解析
// （JSON 说变异 S3 弄红 #1，TASK.md 说弄红 #2；见 G4）

service items_catalog {

  src S1 "清单接口 GET /v1/items 返回一个 JSON 对象，顶层键是 items，值是字符串数组。"
  src S2 "目录为空时也要返回合法对象，items 是空数组，不要返回空 body。"
  src S3 "清单必须是按字典序排列的。"

  promise R1 "GET /v1/items 的响应体是一个 JSON 对象，顶层只有 items 一个键，其值是字符串数组" {
    from S1
    status regress
    goal list_envelope
    wire 5
    reads "在固定两条目夹具目录上发 GET /v1/items，用断言 5 精确比对整个 body：顶层键 items，值为两元素数组且依次是 a 和 b；只做整体精确比对，不做字段级解析或子集包含"
    bounds "不约束状态码与响应头，不约束 Content-Type，不约束条目数不等于 2 的目录，不逐项校验元素是否真为字符串，不约束响应是否随目录真实内容变化，也不约束 items 之外任何键的语义"
    trap "把整个 body 写成常量字符串照样过断言 5；数组里塞非字符串元素或多塞一个键，在现有夹具上同样无感；本条自身无法证明 items 来自目录真实内容，该缺的判据见 G1"
    evidence S1
  }

  promise R2 "目录为空时 GET /v1/items 仍返回合法对象，items 是空数组，且 body 非空" {
    from S2
    status regress
    goal empty_is_object
    wire 6
    reads "在空目录夹具上发 GET /v1/items，用断言 6 精确比对整个 body：顶层键 items，值为空数组；body 为空、键缺失或数组非空都判红"
    bounds "不约束状态码与响应头，不约束只有一条与全被过滤之间的那些规模，不约束读目录失败时的行为，不约束空 body 之外的其它非法空表示（如 204 无 body）"
    trap "把所有失败都吞成空目录再返回空数组，本条全绿；把空数组 body 写成常量也全绿；真目录为空与读取失败在现有判据下不可区分，该缺的判据见 G2"
    evidence S2
  }

  promise R3 "GET /v1/items 返回的 items 数组按码点字典序升序排列" {
    from S3
    status regress
    wire 5
    unit 1,2
    reads "单元层跑样例 1，dec_sort 吃 b 和 a 必须吐出 a 和 b；跑样例 2，dec_sort 吃空数组必须吐出空数组；接口层只靠断言 5 的精确 body 顺带看见一次升序，本条不新增其它顺序判据"
    bounds "不约束大小写折叠、locale、自然数序与非 ASCII 的次序；不约束 dec_sort 的算法、稳定性与是否原地；不约束分页与流式；不约束 items 之外任何数组的次序"
    trap "dec_sort 单测全绿但接口根本不调用它，也能过本条：夹具目录恰好按 a 再 b 返回，断言 5 照旧精确相等；清单里明确没有排完再倒序这类变异可依，该缺的接口层判据见 G3"
    evidence @1,@2
  }

  promise R4 "清单接口上线不改变既有行为：未鉴权的 GET /v1/items 返回 401，GET /v1/health 返回 200" {
    from S1
    status regress
    wire 1,2
    reads "跑断言 1：GET /v1/health 必须 200；跑断言 2：不带凭证的 GET /v1/items 必须 401；两条都只看状态码，不比对 body"
    bounds "不约束鉴权机制与凭证来源，不约束 401 的响应体与 WWW-Authenticate，不约束 403 等其它 4xx 是否也可接受，不约束 health 的 body，也不约束清单接口自身的任何返回形状"
    trap "把鉴权检查挪到读取目录之后、或把任何 4xx 都记成绿，本条照过；本条没有鉴权必须先于 IO 这一判据，该缺的判据与登记授权问题见 G4"
    evidence S3,S4
  }

  choice A1 S1 "顶层必须恰好只有 items 一个键" "顶层至少要含 items 键，允许 next_cursor 之类附加键" "顶层必须恰好只有 items 一个键" "断言 5 对整个 body 精确比对，多出任何键即判红，判据已把读法钉在精确对象上；R1 的 bounds 同时声明不约束附加键的其它语义"

  choice A2 S1 "值是字符串数组只是对夹具 body 的形状描述，判据止于精确比对" "值必须逐项校验为字符串并在遇到非字符串时拒绝" "值是字符串数组只是对夹具 body 的形状描述，判据止于精确比对" "清单里没有非字符串元素的样例也没有对应变异，后一种读法无任何判据可依；这个缺口不另开承诺，记在 G1 上挂 R1"

  choice A3 S2 "目录为空指目录里没有任何条目" "目录为空指解析或过滤后结果集为空，目录本身可以非空" "目录为空指目录里没有任何条目" "断言 6 只在空目录夹具上跑，两种读法在同一判据下不可区分；选前者因为它是 S2 的字面所指，后者需要过滤语义的判据而三句需求都没提过滤"

  choice A4 S3 "字典序指按字符码点逐位比较的升序" "字典序指大小写无关或依运行环境 locale 的排序" "字典序指按字符码点逐位比较的升序" "样例 1 与样例 2 只覆盖全小写 ASCII 与空数组，两种读法结果相同故判据不裁决；选码点序因为它不依赖运行环境，是唯一可跨环境复现的读法"

  hole G1 R1 "缺 items 必须来自目录真实内容 的判据：变异表没有常量返回或改夹具内容这类变异，样例也没有第二套目录，非字符串元素同样无判据；这是验收表判据缺失，不构成 S1 违约，需新增断言或样例才能闭合" waived

  hole G2 R2 "缺 读目录失败不得静默降级成空清单 的判据：无失败注入变异，样例 2 只测 dec_sort 传空数组且不触及 IO 路径；失败与真目录空在现有介质上不可区分，故不算 S2 违约" waived

  hole G3 R3 "缺 接口返回顺序随目录返回顺序变化 的判据：清单明确没有排完再倒序这类变异，也没有第二套夹具，断言 5 只覆盖一次恰好有序的输入；S3 已由样例 1、样例 2 认领，接口层顺序判据缺失不算违约，闭合需要新断言或新变异" waived

  hole G4 R4 "缺 谁授权登记断言 1 与断言 2 的判据：三句需求没有任何一句主张鉴权或存活探针，from 引 S1 是被 L1 与 L7 逼出来的占位引用；此外 TASK.md 说变异 S3 弄红断言 2，inventory.json 说 S3 弄红断言 1，本件把断言 1 与断言 2 同时写进 wire 以兼容两种口径，真正的归属判据缺失，不算 S1 违约" waived
}
