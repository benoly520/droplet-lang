service ab {
  src S1 "清单接口 GET /v1/items 返回一个 JSON 对象，顶层键是 items，值是字符串数组。"
  src S2 "目录为空时也要返回合法对象，items 是空数组，不要返回空 body。"
  src S3 "清单必须是按字典序排列的。"

  promise R1 "清单响应是一个只以 items 为顶层键的对象，其值按断言 #5 的字面 body 判定" {
    from S1
    status regress
    goal list_envelope
    wire 5
    reads "带鉴权取 GET /v1/items，把响应 body 与断言 #5 记的那份 items 为 a 与 b 的字面数组逐字节精确比对，相等即绿"
    bounds "不约束媒体类型与状态码，不约束元素类型（见 R6），不约束排序（见 R3、R7），不约束条目数量，不约束单项读取与未知 key（断言 #3、#4 不在本文件处置），也不约束除这份字面 body 之外的任何响应形状"
    trap "把 #5 那份 body 直接写死成 canned response 就能骗过本条，而清单里没有这种变异，写死的反例无人认领，归 G1 管"
    evidence S1
  }

  promise R2 "目录为空时仍返回 items 为空数组的对象而不是空 body" {
    from S1,S2
    status regress
    goal empty_is_object
    wire 6
    unit 2
    reads "在空目录下取 GET /v1/items，把 body 与断言 #6 记的字面空 items 精确比对；另跑样例 @2 复核空输入的排序结果仍是空"
    bounds "不约束目录为何为空（不存在、未挂载还是无条目，见 A3），不约束媒体类型，不约束 items 元素类型，不约束非空目录的形状（由 R1 管）"
    trap "在 body 之外把传输层写成非 JSON 媒体类型、或给测试用的那个空目录写特例分支，都能让 #6 常绿而语义已经走样；这类反例清单里无判据，归 G2 管"
    evidence S2,@2
  }

  promise R3 "清单条目比较函数按码点升序排出字典序" {
    from S3
    status regress
    unit 1
    reads "跑样例 @1：dec_sort 对 b 在前的两元素输入须返回 a 在前的数组，只测纯函数，不经 HTTP"
    bounds "不约束清单接口响应的顺序（见 R7），不约束稳定排序与并列项的处理，不约束大小写混合或含数字输入下的次序（见 A4、G3）"
    trap "写一个恰好把 b 排在 a 后、却按长度或首字母排的函数照样过 @1，接口输出也就照样不字典序；这条反例清单里没有判据，归 G3 管"
    evidence @1
  }

  promise R4 "服务存活面可判定：GET /v1/health 仍返回 200" {
    from S1
    status regress
    wire 1
    reads "取 GET /v1/health 须得 200；本条只为认领清单里的变异 S3 而存在（清单把 S3 记为弄红 #1），不是把需求读出了鉴权或存活语义"
    bounds "不约束 health 的 body、状态码之外的任何存活细节，不约束清单接口本身，不把 S1 那句话扩成存活要求"
    trap "整个删掉存活面会弄红 #1，而那与清单 envelope 毫无关系，判据与需求错位；该越界反例归 G4 管，清单散文与清单数据对 S3 落点的分歧也记在 G4 与 G5"
    evidence S3
  }

  promise R5 "未鉴权的清单请求不得返回清单对象，须得 401" {
    from S1
    status regress
    wire 2
    reads "不带凭据取 GET /v1/items 须得 401；本条同样只为认领清单里的变异 S4（清单接口一律 500 会弄红 #2）而存在"
    bounds "只认 401 这一个状态码，不约束其它 4xx，不约束鉴权机制、凭据形态与令牌有效期，也不约束鉴权通过之后的形状（由 R1 管）"
    trap "把一律 500 改成一律 401 早退，本条常绿而清单接口其实已经不可用；更关键的是去掉鉴权这个最像的反例，清单数据把变异 S3 记在 #1、散文却记在本条的 #2 上，两边不一致，本条无据可认领，归 G5 管"
    evidence S4
  }

  promise R6 "items 的值必须是字符串数组，元素类型须被约束" {
    from S1
    status gap
    reads "本条无可执行判据：#5 只做一份字面 body 的精确比对，从不单独检查元素类型，所以这一句只能随 R1 的字面比对间接成立，不单独成立"
    bounds "本条不新增任何约束，只登记 S1 后半句里机制覆盖不到的那一半：元素是否为字符串"
    trap "无：本条没有能骗过它的错实现，因为根本没有判据；一旦补出元素类型断言或非字符串元素的变异，就用那条判据的编号把本条从 gap 改回 regress 并闭合 G6"
    evidence none
  }

  promise R7 "GET /v1/items 返回的清单本身是按字典序排列的" {
    from S3
    status gap
    reads "本条无可执行判据：清单里没有任何断言比对响应数组的次序，样例 @1 又只测函数不测响应，所以接口层的顺序承诺只能登记成 gap"
    bounds "本条不约束比较函数的实现细节（R3 管），也不约束去重与稳定排序，只登记机制覆盖不到的那一半：响应里的次序"
    trap "无：按 TASK 的注，没有排完再倒序这种变异，#5 又是恰好已排序的字面 body，所以把响应倒着排这种错实现落在本条上无人认领，缺的判据写在 G7，补出编号后本条改 regress"
    evidence none
  }

  choice A1 S1 "顶层键恰好只有 items 这一个，多一个少一个都算违约" "至少要有 items 这个顶层键，允许多余的顶层键并存" "顶层键恰好只有 items 这一个，多一个少一个都算违约" "断言 #5 与 #6 都是精确比对整份 body，任何多余或缺失的顶层键都会弄红它们，所以窄读法与判据一致"
  choice A2 S1 "返回一个 JSON 对象只指 body 的 JSON 结构，不涉及传输层的媒体类型" "返回一个 JSON 对象还要求响应带 JSON 媒体类型" "返回一个 JSON 对象只指 body 的 JSON 结构，不涉及传输层的媒体类型" "清单里没有比对媒体类型的判据，按能判定的读法登记，媒体类型那一半另记在 G2"
  choice A3 S2 "目录为空指目录存在且其中没有任何条目" "目录为空还包含目录不存在或未挂载的情形" "目录为空指目录存在且其中没有任何条目" "断言 #6 的前置条件只写了空目录，清单里没有缺目录的断言或变异，按可判定的读法登记"
  choice A4 S3 "字典序指对字符串按 Unicode 码点升序比较" "字典序指按大小写不敏感或本地化的 collation 比较" "字典序指对字符串按 Unicode 码点升序比较" "样例 @1 的输入输出只含小写字母，两种读法都过 @1，取更严的码点读法；将来出现混合大小写的样例时按 A1 到 A4 之外的新编号重开"

  hole G1 R1 "缺一个把 #5 的字面 body 写死成 canned response 的变异；清单里没有这种变异，所以这条反例无人认领，但判据本身已与 #5 对齐，不算违约" waived
  hole G2 R2 "缺内容形态判据：断言 #5、#6 只精确比对 body 字节，没有比对媒体类型的断言，也没有非 JSON 内容形态的变异，所以缺的这一半不算对本条的违约" waived
  hole G3 R3 "缺两样判据：混合大小写或含数字输入的排序样例，以及任何把纯函数与响应次序连起来的断言；只有 @1 这一个两元素小写样例，扩不到接口层，不算对本条的违约" waived
  hole G4 R4 "缺一条把断言 #1 与三句需求连起来的读法：本条不为需求而写，只为满足孤儿判据规则而存在；并且清单数据把变异 S3 记为弄红 #1，TASK 散文却说它弄红 #2，两份介质口径不一致，本登记按清单 JSON 落点处理，不算违约" waived
  hole G5 R5 "缺一条能认领去掉鉴权这一反例的 evidence：清单 JSON 把变异 S3 落在 #1，散文把它落在本条的 #2，两边对不上，在清单改掉之前本条只能靠变异 S4 成立，不算违约" waived
  hole G6 R6 "缺一个能单独判定 items 元素类型的断言或变异，机制里没有类型这一层，这一句只能表达不了，不算违约；闭合它的编号是将来那条元素类型判据的断言号" waived
  hole G7 R7 "缺一条比对响应数组次序的断言，以及清单自己承认没有的排完再倒序变异；次序只在函数层可判，接口层表达不了，不算违约；闭合它的编号是将来那条次序断言的断言号" waived
}
