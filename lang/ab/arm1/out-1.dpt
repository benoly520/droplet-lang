service catalog {

  src S1 "清单接口 GET /v1/items 返回一个 JSON 对象，顶层键是 items，值是字符串数组。"
  src S2 "目录为空时也要返回合法对象，items 是空数组，不要返回空 body。"
  src S3 "清单必须是按字典序排列的。"

  promise R1 "清单接口的成功响应是顶层仅一个键 items、值为字符串数组的 JSON 对象。" {
    from S1
    status regress
    goal list_envelope
    wire 5
    reads "已鉴权调用 GET /v1/items（目录非空、含两个条目），把响应 body 与断言 #5 的期望字面量逐字节精确比对：期望顶层仅 items 一个键，其值为两个字符串元素 a 与 b 组成的数组。"
    bounds "不约束两个以上条目的目录输出，不约束元素的内容与大小写，不约束元素是否唯一，不约束 HTTP 状态码与响应头，不约束排序（排序见 R3），不约束分页与错误路径。"
    trap "把清单 body 写成常量、对任何目录都吐同一串字面量的实现能骗过本条，因为判据里只有这一组固定字面量，见 G1。"
    evidence S1
  }

  promise R2 "目录为空时清单接口仍返回顶层仅 items 一个键、值为空数组的 JSON 对象，不返回空 body。" {
    from S1,S2
    status regress
    goal empty_is_object
    wire 6
    reads "已鉴权调用 GET /v1/items（空目录），把响应 body 与断言 #6 的期望字面量逐字节精确比对：期望顶层仅 items 一个键，其值为空数组。"
    bounds "不约束空目录时的 HTTP 状态码与响应头，不约束缺键与 null 等其它非法形态是否需要分别可诊断，不约束两个以上条目的排列（见 R1、R3），不约束目录为空的成因。"
    trap "把任意失败路径都兜底成同一个空信封的实现能骗过本条，因为 #6 只看一次空目录响应的字节，不看它是怎么来的，见 G2。"
    evidence S2
  }

  promise R3 "清单数组按字典序输出。" {
    from S1,S3
    status regress
    unit 1,2
    reads "跑样例 @1：对含 b、a 两元素的数组调用清单排序，返回值须 a 在前、b 在后；跑样例 @2：空数组输入须返回空数组；两者都逐元素精确比对返回值。"
    bounds "不约束三个及以上元素的排列，不约束重复值的相对次序即稳定性，不约束大小写与变音符号的先后（读法见 A2），不约束排序发生在解析前还是序列化前，不约束非字符串元素（已由 R1 的读法排除）。"
    trap "只做一次相邻交换、或仅对长度二与长度零的输入有序的实现能骗过本条，因为现有样例不含三元素输入也不含重复值，见 G3、G4。"
    evidence @1,@2
  }

  promise R4 "清单接口的改动不得弄红健康检查。" {
    from S1
    status gap
    wire 1
    reads "调用 GET /v1/health 断言 200；本条实际能检查的只有断言 #1 一项。"
    bounds "不承诺健康检查的返回体与超时，不承诺鉴权规则，不承诺清单接口的任何形状（三句原文均未涉及本条），本条存在只为满足 L7 对变异 S3 的清账要求。"
    trap "任何与断言 #1 无关的破坏都能骗过本条；本条没有可从三句原文推出的内容，见 G5。"
    evidence S3
  }

  promise R5 "清单接口对未鉴权请求保持 401，不得改成 500 或 200。" {
    from S1
    status gap
    wire 2
    reads "未鉴权调用 GET /v1/items 断言 401；本条实际能检查的只有断言 #2 一项。"
    bounds "不承诺鉴权机制与令牌校验规则，不承诺已鉴权路径的状态码与返回体，不承诺错误码文案，本条存在只为满足 L7 对变异 S4 的清账要求。"
    trap "只要未鉴权请求仍返回 401，已鉴权路径一律 500 这类破坏就能骗过本条，见 G6。"
    evidence S4
  }

  choice A1 S1 "顶层必须只有 items 一个键，出现任何其它顶层键即为违约" "只要求 items 键存在且值为字符串数组，多余顶层键不算违约" "选读法一：顶层仅 items 一个键" "判据：本条唯一 wire 是 #5，它逐字节精确比对 body，多余顶层键必然弄红它；按读法二登记会把承诺写弱于判据实际能证的范围，而 bounds 规则要求沉默不算排除。"

  choice A2 S3 "字典序按 Unicode 码点比较，大写字母排在小写之前" "字典序按运行环境的本地化排序规则，大小写与重音结果随环境变化" "选码点序" "判据：样例 @1 只有两个小写 ASCII 元素，两种读法都通过，判据无法区分二者；取不依赖环境且与 #5 的字面量一致的那一侧，判据证不到的部分记在 G4，不作为验收依据。"

  choice A3 S3 "这是对尚待实现的要求，现状未排序，本条在实现前必须是红的" "这是对现状的重申，现状已排序，本条做回归保护" "选回归保护，status 写 regress" "判据：L8 与 E19 规定 new 只允许出现在有基线可判的场合，本工程没有关于清单排序现状的任何基线记录，而样例 1 与 2 已列在清单里，故写 new 会被拒收；基线本身缺失这件事记在 G3。"

  choice A4 S2 "只要 body 非空即为合法对象，空数组之外任何内容都算满足" "必须逐字节等于顶层仅 items 一个键、值为空数组的对象，其余一律违约" "选后者" "判据：#6 本身就是精确比对断言，读法一与判据能力不符；取读法二无需增加任何额外承诺即可验收。"

  choice A5 S1 "值是字符串数组要求每个元素都是字符串，混入数字或 null 即违约" "值是字符串数组只要求它是数组，元素类型不设限" "选前者：每个元素必须是字符串" "判据：#5 的两个元素恰好都是字符串，现有判据无法观察混入其它类型时的行为；按原文字面取严的那一侧登记，判据证不到的部分已由 G1 记录。"

  hole G1 R1 "缺一条覆盖可变条目数的断言：三个及以上条目、混入非字符串元素应被拒。#5 只有一组固定字面量，因此常量硬编码的实现与真正读目录的实现无法区分。为什么不算违约：本条承诺范围以已 proven 的 #5 为准，超出判据的部分不判。闭合它的编号：建议新增断言 #7 与非两元素样例，并同步 list_envelope 的 proven，否则会触发 L3 漂移。" waived

  hole G2 R2 "缺能把目录真为空与失败被兜底成空信封分开的判据，例如同一条断言同时看状态码，或先写入再清空成空目录的动态场景。现有介质只有 #6 一次静态字面量比对，区分不了。为什么不算违约：本条只承诺 #6 能证的部分。闭合它的编号：建议新增断言 #8 覆盖状态码与非空到空的迁移。" waived

  hole G3 R3 "缺现状基线：清单里没有任何 goal 的 proven 覆盖样例 1 与 2，也没有清单排序当前是否已实现的记录，故 status 取 regress 还是 new 无从判定，A3 只是取了不触发 E19 的那一侧。为什么不算违约：判据缺失属登记不完备，不是实现违约。闭合它的编号：补一条基线判定记录，或把样例纳入某 goal 的 proven。" waived

  hole G4 R3 "缺长度三及以上、含重复值、含大小写混合的排序样例，也缺排完再倒序这类变异，因此既证不出真排序，也证不出码点序与本地化序的差别。为什么不算违约：本条以现有样例可证的部分为限，A2 的更严读法只作说明不作验收。闭合它的编号：建议新增样例 @3 与变异 S5。" waived

  hole G5 R4 "缺一句原文：三句需求均未承诺健康检查，而 L1 规定每条 promise 必须有 from，机制里没有无源承诺这个构造，所以只能借用 S1 把本条登记成 gap，让断言 #1 与变异 S3 在 L7 下清账。另有一处冲突：TASK 正文写变异 S3 去掉鉴权并弄红 #2，清单 JSON 写 S3 弄红 #1，本登记以 JSON 为准。为什么不算违约：gap 按定义即表达不了。闭合它的编号：新增覆盖 health 的原文 src，再把本条改判 regress。" waived

  hole G6 R5 "缺一句原文：三句需求均未承诺鉴权，而鉴权必须保持这件事在介质上只能借 S1 以 gap 形式表达。另有一处冲突：TASK 正文把变异 S3 与 S4 都写成弄红 #2，清单 JSON 写 S3 弄红 #1、S4 弄红 #2，本登记以 JSON 为准。为什么不算违约：gap 不构成违约，且本条不声明任何 goal。闭合它的编号：新增覆盖鉴权的原文 src，再把本条改成 regress。" waived
}
