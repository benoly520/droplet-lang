print({ let a = 1 a + 1 })
let add = fn(x) = x + 1
print(add(1))
let g = add
print(g(1))
print([add, g][0](1))
let h = if(true, len, print)
print(h("ab"))
print([1, "文", []])
print(["a,b"])
print(str(["a,b"]))
print(num("-42"))
print(len("文a"))
print(len([1, 2, 3]))
print(range(-2))
print(map(len, ["ab", "文"]))
print(filter(fn(v) = v > 1, [1, 2, 3]))
print(fold(fn(a, b) = a + b, [1, 2, 3], 0))
print(sort([3, 1, 2]))
print(join("-", ["a", "b"]))
print(len("a\\nb"))
print([1, 2] + [3])
print([[1, 2], [3]][1][0])
print([1, 2, 3][1:])
print([1, 2, 3][-1:])
print(1 == "1")
print([1, 2] == [1, 2])
print(1 == 1 || 1 / 0 == 0)
print(!true)
print(-7 / 2)
print(-7 % 2)
print(- 3)
print(if(1 < 2, "小", "大"))
print(if(true, 1, 1 / 0))
fn twice(x) = x * 2
print(twice(3))
fn fact(n) = if(n <= 1, 1, n * fact(n - 1))
print(fact(5))
fn outer(x) {
  fn twice(y) = y + y
  twice(x)
}
print(outer(3))
fn nothing() { }
print(nothing())
print(nothing() == none)
print(map(str, ["a,b"]))
