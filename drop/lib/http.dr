// 用 drop 写的一个 mini Web 服务器。HTTP 的规则全在这一页，语言那边只有 host 这一个口子。
// 跑法：python3 drop.py --port 8087 lib/http.dr 你的程序.dr
// 你的程序只要写 fn handle(req, peer) { ... } 并在里面交回 http_reply(状态, 正文)，最后一句写 http_serve()。
// 这一页碰的宿主命令只有 bind accept recv send peer close date —— 换掉它们，就能换个协议。

let CRLF = "\x0D\x0A"        // 行分隔只认这两个字节：串里写 "\x0D\x0A" 就是两个字符
let CR = "\x0D"
let LF = "\x0A"
let DIGITS = "0123456789"
let HDR_MAX = 65536          // 头部超过这么多字节就不当请求
let BODY_MAX = 1048576       // 正文声明超过这么多字节也不当请求：都是断这条连接，不是错误

// 服务器的「main」：绑到宿主起来时给的那个端口，一条一条地接（Ctrl-C 停）。它不返回。
fn http_serve() {
  let L = host("bind", "")
  accept_loop(L)
}

// 接一条、做完一条、再接下一条。这一句在尾位，所以接多少条都不涨层数。
// conn_loop 会回来：一条连接做到头（对端断了、超上限、或它写了 Connection: close）就回来。
fn accept_loop(L) {
  let c = host("accept", L)
  let one = conn_loop(c, "")
  accept_loop(L)
}

// 一条连接一圈：读满一个请求、交给程序、发出去，然后尾位叫回自己。
fn conn_loop(c, buf) {
  let hr = read_head(c, buf, 0)
  let req = if(hr[0] == "", "", read_body(c, hr[0], hr[1]))
  let out = if(req == "", "", deliver(c, req))
  if(req == "" || out != "", host("close", c), conn_loop(c, ""))
}

// 交给程序：把请求和对端都给 handle，看它交回什么响应，拼成报文发出去。
// 回 "" = 这条连接接着转（keep-alive）；回 "drop" = 关掉它。
// 程序在这里报错 = 整个服务器一红就停 —— 库不兜程序的错，也不接住它。
fn deliver(c, req) {
  let close = has_close(req)
  let resp = handle(req, host("peer", c))
  let sent = host("send", c + LF + packet(req, resp, close))
  if(close, "drop", "")
}

// ---------------------------------------------------------------- 收：攒够一个请求
// 攒到出现一个空行为止，回 [头部（每行都带着自己的 CRLF）, 空行后面的字节]；
// 头部为 "" = 这条连接当不了请求：对端断了、或头部超过 HDR_MAX。
// at = 扫描接着「上一轮没读够的那三个字节」往下找，所以攒多少字节都只扫一遍。
fn read_head(c, buf, at) {
  let cut = find_blank(buf, at)
  let ch = if(cut < 0 && len(buf) <= HDR_MAX, host("recv", c), "")
  let more = cut < 0 && ch != ""
  if(cut >= 0 || !more, if(cut >= 0, [buf[0:cut + 2], buf[cut + 4:]], ["", ""]),
     read_head(c, buf + ch, if(at == 0, 0, len(buf) - 3)))
}

// 第一个「前面也有一对 CRLF 的 CRLF」的下标，也就是那个空行的起点；没有回 -1。
// 只认 CRLF，所以 LF-only 的请求在这里永远切不出头部 —— 那是断连接，不是错误。
// 下面这些一圈一圈的函数都长成同一个样子：先几个 let 把判据算出来，最后一句 if 的
// 一支里直接写自己 —— 定义说尾位是「函数体块的最后一句」，往 if 里再套一层就不算了，
// 那样每转一圈涨一层，第 201 圈就是 E13。这是「循环只有一种」真正的写法。
fn find_blank(s, i) {
  let stop = len(s) <= i + 3
  let hit = if(stop, false, is_crlf(s, i) && is_crlf(s, i + 2))
  if(stop || hit, if(hit, i, -1), find_blank(s, i + 1))
}

fn is_crlf(s, i) { s[i] == CR && s[i + 1] == LF }

// 按 Content-Length 把正文收齐，回一整段请求：头部 + 空行 + 正文。"" = 当不了请求。
// 正文里声明之外多出来的字节这里不认（一次请求只有一段正文）。
fn read_body(c, head, rest) {
  let want = content_length(head)
  let ch = if(want > len(rest) && want <= BODY_MAX, host("recv", c), "")
  let ok = want >= 0 && want <= BODY_MAX
  if(ok && want > len(rest) && ch != "", read_body(c, head, rest + ch),
     if(ok && want <= len(rest), head + CRLF + rest[0:want], ""))
}

// 只认「Content-Length: 数字」这一种写法（大小写算不同，续行不认）；没这行 = 0。
// 写法不对 = -1，由调用方断这条连接：对端乱发是它的事，不该让整个服务器停下来。
fn content_length(head) { cl_of(split(head, CRLF), 1) }

fn cl_of(ls, i) {
  let over = len(ls) <= i
  let hit = !over && name_of(ls[i]) == "Content-Length"
  if(hit || over, if(hit, cl_num(ls[i]), 0), cl_of(ls, i + 1))
}

// 对端写了 Connection: close（一模一样、单独占一行）就算它要关。只看头部，不看请求行。
fn has_close(req) { one_close(split(req, CRLF), 1) }

fn one_close(ls, i) {
  let over = len(ls) <= i
  let hit = !over && ls[i] == "Connection: close"
  if(hit || over, hit, one_close(ls, i + 1))
}

fn name_of(ln) { split(ln, ":")[0] }

fn cl_num(ln) {
  let cut = find_colon(ln, 0)
  let val = ln[cut + 1:]
  let from = skip_spaces(val, 0)
  let end = digit_end(val, from)
  if(end == len(val) && end > from, num(val[from:end]), -1)
}

fn find_colon(s, i) {
  let go = len(s) > i && s[i] != ":"
  if(go, find_colon(s, i + 1), if(len(s) <= i, -1, i))
}

fn skip_spaces(s, i) {
  let go = len(s) > i && s[i] == " "
  if(go, skip_spaces(s, i + 1), i)
}

fn digit_end(s, i) {
  let go = len(s) > i && digit_val(s[i]) >= 0
  if(go, digit_end(s, i + 1), i)
}

// 没有 ord：一个字符是几，就看它在 "0123456789" 里排第几；排不进去 = -1。
fn digit_val(ch) { find_char(DIGITS, ch, 0) }

fn find_char(s, ch, i) {
  let go = len(s) > i && s[i] != ch
  if(go, find_char(s, ch, i + 1), if(len(s) <= i, -1, i))
}

// ---------------------------------------------------------------- 发：拼一个响应
// 四行头（状态行、Date、Content-Type、Content-Length），对端要 close 就多一行，然后空行。
// 正文走 bytes 那条路，出去的就是那些字节；HEAD 只回头，Content-Length 写 0。
// 交回给宿主的那一串是「句柄 + 换行 + 要发的字节」：只有第一个换行是分隔，
// 后面那些字节原样出去 —— 所以头部和正文里那些换行都不碍事。
fn packet(req, resp, close) {
  let l0 = split(req, CRLF)[0]
  let body = bytes(resp[1])
  let head_only = starts_with(l0, "HEAD ")
  head_lines(l0, resp[0], if(head_only, "0", str(len(body))), close) + if(head_only, "", body)
}

fn head_lines(l0, st, cl, close) {
  "HTTP/1.1 " + str(st) + " " + reason(st) + CRLF +
  "Date: " + host("date", "") + CRLF +
  "Content-Type: text/plain; charset=utf-8" + CRLF +
  "Content-Length: " + cl + CRLF +
  if(close, "Connection: close" + CRLF, "") +
  CRLF
}

// 原因短语由库给，程序管不着；表里没有的就写 Drop。
fn reason(st) {
  if(st == 200, "OK", if(st == 201, "Created", if(st == 204, "No Content",
  if(st == 400, "Bad Request", if(st == 404, "Not Found",
  if(st == 405, "Method Not Allowed", if(st == 500, "Internal Server Error", "Drop")))))))
}

// ---------------------------------------------------------------- 程序的出口和工具
// 程序交回一个响应就这一条路：没有多个返回值，所以一次请求也只可能有一个响应。
fn http_reply(status, body) { [status, body] }

// 请求行第 n 个词：请求行是头部第一行，按空格切开。
fn http_word(req, n) { split(split(req, CRLF)[0], " ")[n] }

// 请求体 = 第一个空行后面的那些字节。
fn http_body(req) {
  let cut = find_blank(req, 0)
  if(cut < 0, "", req[cut + 4:])
}

fn starts_with(s, t) { s[0:len(t)] == t }
